# Kiln's additions to the kernel config (BoardConfigKiln.mk TARGET_KERNEL_CONFIG_EXT).
# virtio-9p: Android's folders kept on the Mac (launcher MacFolders, QemuCommand -fsdev; mounted by kiln_boot.rc). Built in,
# so nothing has to load it before the mount.
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
