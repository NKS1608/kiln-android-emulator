+static char *virt_get_kiln_cpus(Object *obj, Error **errp)
+{
+    return g_strdup(VIRT_MACHINE(obj)->kiln_cpus ? VIRT_MACHINE(obj)->kiln_cpus : "");
 }
 
+static void virt_set_kiln_cpus(Object *obj, const char *value, Error **errp)
+{
+    VirtMachineState *vms = VIRT_MACHINE(obj);
+
+    g_free(vms->kiln_cpus);
+    vms->kiln_cpus = g_strdup(value);
+}
