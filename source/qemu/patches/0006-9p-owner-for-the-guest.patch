9p (local, security_model=none): owner_uid and owner_gid report every file as owned by them, the group getting the
owner's permissions. Kiln's shared folder: Android's apps reach it through the media_rw group, while the files on the
Mac belong to the Mac user; QEMU still does every operation as that user.

diff --git a/fsdev/file-op-9p.h b/fsdev/file-op-9p.h
index 1d93114..525287e 100644
--- a/fsdev/file-op-9p.h
+++ b/fsdev/file-op-9p.h
@@ -101,6 +101,10 @@ typedef struct FsDriverEntry {
     FsThrottle fst;
     mode_t fmode;
     mode_t dmode;
+    /* owner_uid/owner_gid: every file is reported as theirs (see FsContext) */
+    bool owner_set;
+    uid_t owner_uid;
+    gid_t owner_gid;
     /* temporary storage for parse_opts only */
     uint32_t max_xattr;
 } FsDriverEntry;
@@ -116,6 +120,15 @@ struct FsContext {
     void *private;
     mode_t fmode;
     mode_t dmode;
+    /*
+     * security_model=none with owner_uid and owner_gid: every file is reported as owned by them, the group getting the
+     * owner's permissions, whoever owns it on the host. A guest whose users are not the host's (Android's apps reach a
+     * shared folder through the media_rw group) can then use the files the host user made; the host still does every
+     * operation as the user QEMU runs as.
+     */
+    bool owner_set;
+    uid_t owner_uid;
+    gid_t owner_gid;
     /* max. amount of simultaneously open xattr FIDs */
     uint32_t xattr_fid_limit;
     /* current amount of open xattr FIDs */
