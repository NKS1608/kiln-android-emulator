diff --git a/hw/9pfs/9p-local.c b/hw/9pfs/9p-local.c
index ee592b6..94a302e 100644
--- a/hw/9pfs/9p-local.c
+++ b/hw/9pfs/9p-local.c
@@ -183,6 +183,16 @@ static void local_mapped_file_attr(int dirfd, const char *name,
     fclose(fp);
 }
 
+/* owner_uid/owner_gid: the file as the guest sees it (FsContext.owner_set). */
+static void local_owner_attr(FsContext *fs_ctx, struct stat *stbuf)
+{
+    if (fs_ctx->owner_set) {
+        stbuf->st_uid = fs_ctx->owner_uid;
+        stbuf->st_gid = fs_ctx->owner_gid;
+        stbuf->st_mode |= (stbuf->st_mode & 0700) >> 3;
+    }
+}
+
 static int local_lstat(FsContext *fs_ctx, V9fsPath *fs_path, struct stat *stbuf)
 {
     int err = -1;
@@ -225,6 +235,7 @@ static int local_lstat(FsContext *fs_ctx, V9fsPath *fs_path, struct stat *stbuf)
     } else if (fs_ctx->export_flags & V9FS_SM_MAPPED_FILE) {
         local_mapped_file_attr(dirfd, name, stbuf);
     }
+    local_owner_attr(fs_ctx, stbuf);
 
 err_out:
     close_preserve_errno(dirfd);
@@ -819,6 +830,7 @@ static int local_fstat(FsContext *fs_ctx, int fid_type,
         errno = EOPNOTSUPP;
         return -1;
     }
+    local_owner_attr(fs_ctx, stbuf);
     return err;
 }
 
@@ -1609,6 +1621,20 @@ static int local_parse_opts(QemuOpts *opts, FsDriverEntry *fse, Error **errp)
         }
     }
 
+    if (qemu_opt_find(opts, "owner_uid") || qemu_opt_find(opts, "owner_gid")) {
+        if (!(fse->export_flags & V9FS_SM_NONE)) {
+            error_setg(errp, "owner_uid and owner_gid are only valid with security_model=none");
+            return -1;
+        }
+        if (!qemu_opt_find(opts, "owner_uid") || !qemu_opt_find(opts, "owner_gid")) {
+            error_setg(errp, "owner_uid and owner_gid go together");
+            return -1;
+        }
+        fse->owner_set = true;
+        fse->owner_uid = qemu_opt_get_number(opts, "owner_uid", 0);
+        fse->owner_gid = qemu_opt_get_number(opts, "owner_gid", 0);
+    }
+
     fse->path = g_strdup(path);
 
     return 0;
